diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,31 @@
+name: CI
+
+on:
+  push:
+    branches: [ main ]
+  pull_request:
+    branches: [ main ]
+
+jobs:
+  build:
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ ubuntu-latest, macos-latest, windows-latest ]
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Set up JDK 11
+        uses: actions/setup-java@v4
+        with:
+          java-version: '11'
+          distribution: 'temurin'
+          cache: maven
+
+      - name: Build with Maven
+        run: mvn clean package -pl distribution -am -DskipTests
+
+      - name: Upload integration-test logs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: integration-test-logs-${{ matrix.os }}
+          path: integration-test/target/logs/
+          retention-days: 30
diff --git a/Dockerfile b/Dockerfile
new file mode 100644
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,13 @@
+FROM openjdk:11-slim
+
+LABEL maintainer="Apache IoTDB Team"
+
+ENV IOTDB_VERSION=2.0.7-SNAPSHOT
+
+RUN mkdir -p /iotdb
+
+COPY distribution/target/apache-iotdb-${IOTDB_VERSION} /iotdb
+
+WORKDIR /iotdb
+
+EXPOSE 6667
+
+CMD ["/iotdb/sbin/start-server.sh"]
diff --git a/Makefile b/Makefile
new file mode 100644
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,11 @@
+.PHONY: docker-build docker-run
+
+IOTDB_VERSION ?= 2.0.7-SNAPSHOT
+DOCKER_IMAGE ?= iotdb:${IOTDB_VERSION}
+
+docker-build:
+	@echo "Building Docker image ${DOCKER_IMAGE}..."
+	docker build -t ${DOCKER_IMAGE} .
+
+docker-run:
+	@echo "Running Docker container from ${DOCKER_IMAGE}..."
+	docker run -d -p 6667:6667 --name iotdb ${DOCKER_IMAGE}
