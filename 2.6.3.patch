@@ -0,0 +1,11 @@
+FROM openjdk:11-slim
+
+ARG IOTDB_VERSION
+
+COPY distribution/target/iotdb-${IOTDB_VERSION}/ /opt/iotdb/
+
+WORKDIR /opt/iotdb
+
+EXPOSE 6667
+
+CMD sbin/start-standalone.sh && tail -F logs/*.log
diff --git a/Makefile b/Makefile
new file mode 100644
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,12 @@
+IOTDB_VERSION ?= 2.6.3
+IMAGE_NAME ?= iotdb
+CONTAINER_NAME ?= iotdb-container
+PORT ?= 6667
+
+.PHONY: docker-build docker-run
+
+docker-build:
+	@echo "docker build --build-arg IOTDB_VERSION=$(IOTDB_VERSION) -t $(IMAGE_NAME):$(IOTDB_VERSION) ."
+
+docker-run:
+	@echo "docker run --rm --name $(CONTAINER_NAME) -p $(PORT):6667 $(IMAGE_NAME):$(IOTDB_VERSION)"