+
+FROM openjdk:11-slim
+
+ARG IOTDB_VERSION=2.0.7-SNAPSHOT
+
+WORKDIR /iotdb
+
+COPY distribution/target/apache-iotdb-${IOTDB_VERSION} /iotdb
+
+EXPOSE 6667
+
+ENV PATH="/iotdb/sbin:${PATH}"
+
+CMD ["start-standalone.sh"]
