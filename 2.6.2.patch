diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,48 @@
+name: CI
+
+on:
+  push:
+    branches:
+      - main
+  pull_request:
+
+jobs:
+  build:
+    name: ${{ matrix.os }} / JDK 11
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os:
+          - ubuntu-latest
+          - macos-latest
+          - windows-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 11
+        uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 11
+          cache: maven
+
+      - name: Build distribution
+        shell: bash
+        run: mvn clean package -pl distribution -am -DskipTests
+
+      - name: Upload integration-test logs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: integration-test-logs-${{ matrix.os }}
+          if-no-files-found: ignore
+          retention-days: 7
+          path: |
+            integration-test/**/*.log
+            integration-test/**/logs/**
+            integration-test/**/target/failsafe-reports/**
+            integration-test/**/target/surefire-reports/**
+            integration-test/**/target/*.log
diff --git a/Dockerfile b/Dockerfile
new file mode 100644
--- /dev/null
+++ b/Dockerfile
@@ -0,0 +1,11 @@
+FROM openjdk:11-slim
+
+ARG IOTDB_VERSION
+ENV IOTDB_HOME=/opt/iotdb
+
+WORKDIR /opt
+COPY distribution/target/iotdb-${IOTDB_VERSION} ${IOTDB_HOME}
+
+WORKDIR ${IOTDB_HOME}
+EXPOSE 6667
+
+CMD ["sh", "sbin/start-standalone.sh"]
diff --git a/Makefile b/Makefile
new file mode 100644
--- /dev/null
+++ b/Makefile
@@ -0,0 +1,10 @@
+IOTDB_VERSION ?= 2.0.7-SNAPSHOT
+IMAGE_NAME ?= iotdb:$(IOTDB_VERSION)
+CONTAINER_NAME ?= iotdb
+PORT ?= 6667
+
+docker-build:
+	@echo docker build --build-arg IOTDB_VERSION=$(IOTDB_VERSION) -t $(IMAGE_NAME) .
+
+docker-run:
+	@echo docker run -d --name $(CONTAINER_NAME) -p $(PORT):6667 $(IMAGE_NAME)
